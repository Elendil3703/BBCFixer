+// chokidar 4 no longer expands globs: a pattern handed to `chokidar.watch` is
+// taken as a literal path, so it matches nothing and no event is ever emitted.
+// The replacement documented in the chokidar v4 README ("Upgrading") is to watch
+// the non-glob base of each pattern and to decide per file with the `ignored`
+// predicate.
+function resolveGlobs(globs) {
+  var positives = [];
+  var negatives = [];
+
+  globs.forEach(function (glob) {
+    if (typeof glob === 'string' && glob.charAt(0) === BANG) {
+      var negated = glob.slice(1);
+      if (negatives.indexOf(negated) === -1) {
+        negatives.push(negated);
+      }
+      return;
+    }
+
+    var idx = negatives.indexOf(glob);
+    if (idx !== -1) {
+      negatives.splice(idx, 1);
+    }
+    if (positives.indexOf(glob) === -1) {
+      positives.push(glob);
+    }
+  });
+
+  var roots = [];
+  positives.forEach(function (glob) {
+    var base = picomatch.scan(glob).base || '.';
+    if (roots.indexOf(base) === -1) {
+      roots.push(base);
+    }
+  });
+
+  return { roots: roots, positives: positives, negatives: negatives };
+}
+
+function toMatcher(matchers) {
+  var patterns = [];
+  var others = [];
+
+  [].concat(matchers || []).forEach(function (matcher) {
+    if (typeof matcher === 'string') {
+      patterns.push(matcher);
+    } else if (matcher) {
+      others.push(matcher);
+    }
+  });
+
+  var isMatch = patterns.length
+    ? picomatch(patterns, { dot: true })
+    : function () {
+        return false;
+      };
+
+  return function (filepath, relative) {
+    if (isMatch(filepath) || (relative && isMatch(relative))) {
+      return true;
+    }
+    return others.some(function (matcher) {
+      if (matcher instanceof RegExp) {
+        return matcher.test(filepath) || (relative && matcher.test(relative));
+      }
+      if (typeof matcher === 'function') {
+        return matcher(filepath) || (relative && matcher(relative));
+      }
+      return false;
+    });
+  };
+}
