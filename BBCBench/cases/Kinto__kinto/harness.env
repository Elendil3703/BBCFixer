HARNESS=image
IMAGE=kinto__kinto
TEST_CMD="bash /work/test_Kinto__kinto.sh"
NET_ARGS="--network container:kinto-pg"
SIDECAR_NAME=kinto-pg
SIDECAR_RUN='docker run -d --name kinto-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_USER=postgres -e POSTGRES_DB=testdb postgres:14'
SIDECAR_WAIT='for i in $(seq 1 40); do docker exec kinto-pg pg_isready -U postgres >/dev/null 2>&1 && break; sleep 1; done; sleep 2'
INTACT_PIP="SQLAlchemy==1.4.46"
